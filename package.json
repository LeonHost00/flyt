{
  "name": "flyt",
  "version": "1.0.4",
  "author": "Leon <flyt@flytapp.se>",
  "description": "Flyt - Your AI-powered desktop assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "deploy": "electron-builder --publish always"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "^0.0.37",
    "@langchain/core": "^1.1.15",
    "@langchain/langgraph": "^1.0.15",
    "@langchain/openai": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@supabase/supabase-js": "^2.39.0",
    "@xenova/transformers": "^2.17.2",
    "auto-launch": "^5.0.6",
    "axios": "^1.13.2",
    "child_process": "^1.0.2",
    "dotenv": "^17.2.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "form-data": "^4.0.5",
    "katex": "^0.16.27",
    "marked-katex-extension": "^5.1.6",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0",
    "supabase": "^2.72.3"
  },
  "build": {
    "appId": "com.flyt.app",
    "productName": "Flyt",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://flytapp.se/download/windows/"
      }
    ]
  }
}
