{
  "name": "flyt",
  "version": "1.0.4",
  "author": "Leon <flyt@flytapp.se>",
  "description": "Flyt - Your AI-powered desktop assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "deploy": "electron-builder --publish always"
  },
  "dependencies": {
    "@langchain/core": "^1.1.15",
    "@langchain/langgraph": "^1.0.15",
    "@langchain/openai": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@supabase/supabase-js": "^2.39.0",
    "auto-launch": "^5.0.6",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "electron": "^40.0.0",
    "electron-builder": "^26.5.0",
    "katex": "^0.16.27",
    "marked-katex-extension": "^5.1.6",
    "supabase": "^0.5.0"
  },
  "build": {
    "appId": "com.flyt.app",
    "productName": "Flyt",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "auth-renderer.js",
      "index.html",
      "auth.html",
      "snipping.html",
      "theme.css",
      "assets/**/*",
      "tools/**/*",
      "utils/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://flytapp.se/download/windows/"
      }
    ]
  }
}
